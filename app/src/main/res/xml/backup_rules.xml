<?xml version="1.0" encoding="utf-8"?>
<!--
  备份规则：只备份聊天数据库和用户上传文件，
  排除所有包含密钥/API Key/密码的敏感配置（DataStore、SharedPreferences 等）。
-->
<full-backup-content>
    <include
        domain="database"
        path="." />
    <include
        domain="file"
        path="upload/" />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="file"
        path="datastore/" />
    <exclude
        domain="file"
        path="external_memories/" />
</full-backup-content>
